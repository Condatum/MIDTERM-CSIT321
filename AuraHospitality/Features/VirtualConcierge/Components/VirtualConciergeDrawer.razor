@inject ConciergePresenter Presenter
@inject IAppStateService AppState
@implements IConciergeView
@implements IDisposable

@if (AppState.IsConciergeOpen)
{
    <div class="fixed inset-0 z-50 overflow-hidden bg-slate-950/60 backdrop-blur-sm transition-opacity">
        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col justify-between border-l border-sand-200">
                <!-- Header -->
                <div class="p-6 border-b border-sand-200 bg-gradient-to-r from-primary-950 to-primary-900 text-white flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <div class="relative">
                            <div class="w-10 h-10 rounded-2xl bg-teal-800 text-gold-300 flex items-center justify-center border border-gold-400/40">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                                </svg>
                            </div>
                            <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-400 rounded-full border-2 border-slate-900"></span>
                        </div>
                        <div>
                            <h3 class="font-serif-luxury text-base font-bold text-white">Celeste AI Concierge</h3>
                            <span class="text-[10px] text-teal-300 block">Personalized 24/7 Hospitality Assistant</span>
                        </div>
                    </div>
                    <button @onclick="@(() => AppState.ToggleConcierge(false))" class="text-white/70 hover:text-white p-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Chat History Messages -->
                <div class="flex-1 overflow-y-auto p-6 space-y-4 bg-sand-50/50">
                    @foreach (var msg in _messages)
                    {
                        <div class="flex flex-col @(msg.Sender == "Guest" ? "items-end" : "items-start")">
                            <div class="flex items-center gap-1.5 mb-1 text-[10px] text-slate-400">
                                <span>@msg.Sender</span>
                                <span>&bull;</span>
                                <span>@msg.Timestamp.ToString("HH:mm")</span>
                            </div>
                            <div class="max-w-[85%] p-4 rounded-2xl text-xs leading-relaxed @(msg.Sender == "Guest" ? "bg-primary-900 text-white rounded-br-none shadow-md" : "bg-white text-slate-800 border border-sand-200 rounded-bl-none shadow-sm")">
                                @msg.Content
                            </div>

                            <!-- Quick Suggestion Buttons -->
                            @if (msg.QuickReplies != null && msg.QuickReplies.Any())
                            {
                                <div class="flex flex-wrap gap-1.5 mt-2 max-w-[90%]">
                                    @foreach (var reply in msg.QuickReplies)
                                    {
                                        <button @onclick="@(() => Presenter.SendMessage(reply))"
                                                class="text-[10px] px-2.5 py-1 rounded-full bg-white hover:bg-teal-50 border border-sand-300 hover:border-teal-400 text-slate-700 transition">
                                            @reply
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Input Field -->
                <div class="p-4 border-t border-sand-200 bg-white">
                    <form @onsubmit="@(() => Presenter.SendMessage())" class="flex gap-2">
                        <input type="text"
                               @bind="Presenter.CurrentInput"
                               placeholder="Ask Celeste anything (helicopters, dining, boat tours)..."
                               class="flex-1 text-xs p-3 rounded-xl border border-sand-300 bg-sand-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600" />
                        <button type="submit"
                                class="px-4 py-3 rounded-xl bg-primary-900 hover:bg-primary-950 text-white font-bold transition flex items-center justify-center">
                            <svg class="w-4 h-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ConciergeMessage> _messages = Array.Empty<ConciergeMessage>();

    protected override void OnInitialized()
    {
        Presenter.AttachView(this);
        AppState.OnStateChanged += StateHasChanged;
    }

    public void DisplayMessages(IReadOnlyList<ConciergeMessage> messages)
    {
        _messages = messages;
        InvokeAsync(StateHasChanged);
    }

    public void ClearInput()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= StateHasChanged;
    }
}
