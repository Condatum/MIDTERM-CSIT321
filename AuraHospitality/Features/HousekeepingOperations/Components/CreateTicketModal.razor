@inject HousekeepingPresenter Presenter

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-950/70 backdrop-blur-md flex items-center justify-center p-4">
        <div class="relative bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-sand-200 animate-fade-in my-8 p-6 sm:p-8">
            <div class="flex justify-between items-center pb-4 border-b border-sand-200 mb-6">
                <div>
                    <h3 class="font-serif-luxury text-xl font-bold text-slate-900">Dispatch Service Ticket</h3>
                    <p class="text-xs text-slate-500">Assign task to Housekeeping, Butler, or Concierge.</p>
                </div>
                <button @onclick="@(() => Presenter.CloseCreateModal())" class="text-slate-400 hover:text-slate-700 p-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4 mb-6">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Room / Suite</label>
                        <input type="text" @bind="_ticket.RoomNumber" placeholder="e.g. 101, 301" class="w-full text-xs p-2.5 rounded-xl border border-sand-300" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Service Type</label>
                        <select @bind="_ticket.ServiceType" class="w-full text-xs p-2.5 rounded-xl border border-sand-300">
                            <option value="@ServiceType.ButlerRequest">Butler Request</option>
                            <option value="@ServiceType.Housekeeping">Housekeeping Clean</option>
                            <option value="@ServiceType.Concierge">Concierge Assistance</option>
                            <option value="@ServiceType.ActivityDispatch">Excursion Dispatch</option>
                            <option value="@ServiceType.Engineering">Engineering Maintenance</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Task Title / Specification</label>
                    <input type="text" @bind="_ticket.Title" placeholder="e.g. Fresh orchid arrangement and extra feather pillows" class="w-full text-xs p-2.5 rounded-xl border border-sand-300" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Priority</label>
                        <select @bind="_ticket.Priority" class="w-full text-xs p-2.5 rounded-xl border border-sand-300">
                            <option value="@TicketPriority.Low">Low</option>
                            <option value="@TicketPriority.Medium">Medium</option>
                            <option value="@TicketPriority.High">High</option>
                            <option value="@TicketPriority.Urgent">Urgent</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Assigned Staff</label>
                        <input type="text" @bind="_ticket.Assignee" placeholder="e.g. Ramesh, Hans, Team Alpha" class="w-full text-xs p-2.5 rounded-xl border border-sand-300" />
                    </div>
                </div>
            </div>

            <button @onclick="Submit"
                    class="w-full py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider transition">
                Create & Dispatch
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }

    private HousekeepingTicket _ticket = new()
    {
        RoomNumber = "101",
        ServiceType = ServiceType.ButlerRequest,
        Title = "Afternoon high tea and French pastries service",
        Priority = TicketPriority.High,
        Assignee = "Ramesh"
    };

    private void Submit()
    {
        Presenter.SubmitNewTicket(_ticket);
        _ticket = new HousekeepingTicket
        {
            RoomNumber = "104",
            ServiceType = ServiceType.Housekeeping,
            Title = "Evening turndown service with lavender mist",
            Priority = TicketPriority.Medium,
            Assignee = "Kavita"
        };
    }
}
