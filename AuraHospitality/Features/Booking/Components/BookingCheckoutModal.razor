@inject BookingPresenter Presenter
@inject ICurrencyService CurrencyService
@inject IBookingService BookingService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-950/70 backdrop-blur-md flex items-center justify-center p-4">
        <div class="relative bg-white rounded-3xl max-w-2xl w-full overflow-hidden shadow-2xl border border-sand-200 animate-fade-in my-8">
            <div class="p-6 sm:p-8">
                <!-- Header -->
                <div class="flex justify-between items-center pb-4 border-b border-sand-200 mb-6">
                    <div>
                        <h3 class="font-serif-luxury text-2xl font-bold text-slate-900">Secure Your Sanctuary</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Please provide primary guest credentials for private check-in.</p>
                    </div>
                    <button @onclick="@(() => Presenter.CloseCheckout())" class="text-slate-400 hover:text-slate-700 p-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Form Fields -->
                <div class="space-y-4 mb-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Primary Guest Full Name</label>
                            <input type="text" @bind="Presenter.GuestDetails.FullName" class="w-full text-xs p-3 rounded-xl border border-sand-300 bg-sand-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Email Address (VIP Folio Delivery)</label>
                            <input type="email" @bind="Presenter.GuestDetails.Email" class="w-full text-xs p-3 rounded-xl border border-sand-300 bg-sand-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Contact Phone Number</label>
                            <input type="tel" @bind="Presenter.GuestDetails.Phone" class="w-full text-xs p-3 rounded-xl border border-sand-300 bg-sand-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Country of Residence</label>
                            <input type="text" @bind="Presenter.GuestDetails.Country" class="w-full text-xs p-3 rounded-xl border border-sand-300 bg-sand-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Private Butler & Dietary Requests</label>
                        <textarea @bind="Presenter.GuestDetails.SpecialRequests" rows="2" class="w-full text-xs p-3 rounded-xl border border-sand-300 bg-sand-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600" placeholder="e.g., Chilled champagne, hypoallergenic down pillows, late checkout..."></textarea>
                    </div>

                    <!-- Promo Code -->
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Privilege Code / Membership</label>
                        <div class="flex gap-2">
                            <input type="text" @bind="Presenter.GuestDetails.PromoCode" placeholder="Enter AURA10 or LUXURY20" class="flex-1 text-xs p-3 rounded-xl border border-sand-300 bg-sand-50/50 focus:bg-white focus:outline-none uppercase font-semibold" />
                            <span class="px-3 py-3 rounded-xl bg-sand-100 text-[11px] font-bold text-teal-800 flex items-center">AURA10 = 10% OFF</span>
                        </div>
                    </div>
                </div>

                <!-- Price Summary -->
                <div class="p-4 rounded-2xl bg-sand-100/70 border border-sand-200 mb-6">
                    <div class="flex justify-between items-center text-xs text-slate-600 mb-1">
                        <span>Manifest Subtotal (@BookingService.ActiveBookings.Count items)</span>
                        <span class="font-bold">@CurrencyService.FormatPrice(BookingService.ActiveBookings.Sum(b => b.TotalUSD))</span>
                    </div>
                    <div class="flex justify-between items-center text-xs text-emerald-700 mb-2">
                        <span>Complimentary Butler & Helipad Clearance</span>
                        <span class="font-bold">Included</span>
                    </div>
                    <div class="flex justify-between items-center pt-2 border-t border-sand-200 text-sm font-bold text-slate-900">
                        <span>Estimated Total</span>
                        <span class="font-serif-luxury text-lg text-primary-950">@CurrencyService.FormatPrice(BookingService.ActiveBookings.Sum(b => b.TotalUSD))</span>
                    </div>
                </div>

                <!-- Submit Button -->
                <button @onclick="@(() => Presenter.CompleteCheckout())"
                        class="w-full py-4 rounded-2xl bg-gradient-to-r from-primary-800 to-primary-950 hover:from-primary-700 hover:to-primary-900 text-white font-bold text-xs tracking-wider uppercase transition shadow-xl shadow-primary-950/20 flex items-center justify-center gap-2">
                    <svg class="w-4 h-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    <span>Confirm & Generate Digital Key Pass</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
}
