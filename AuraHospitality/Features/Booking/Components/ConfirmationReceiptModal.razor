@inject ICurrencyService CurrencyService
@inject BookingPresenter Presenter

@if (Receipt != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="relative bg-white rounded-3xl max-w-xl w-full overflow-hidden shadow-2xl border border-sand-200 animate-fade-in my-8">
            <!-- Luxury Header -->
            <div class="bg-gradient-to-r from-primary-950 via-primary-900 to-primary-950 text-white p-6 sm:p-8 text-center relative">
                <button @onclick="@(() => Presenter.DismissReceipt())" class="absolute top-4 right-4 text-white/70 hover:text-white p-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
                <div class="w-12 h-12 mx-auto rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-400 flex items-center justify-center mb-3">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h3 class="font-serif-luxury text-2xl sm:text-3xl font-bold">Sanctuary Reservation Secured</h3>
                <p class="text-xs text-sand-300 mt-1">Confirmation Reference: <span class="text-gold-300 font-mono font-bold tracking-wider">@Receipt.ConfirmationNumber</span></p>
            </div>

            <!-- Digital Key Card Visual -->
            <div class="p-6 sm:p-8 space-y-6">
                <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-900 via-primary-950 to-slate-900 text-white border border-gold-400/30 shadow-xl relative overflow-hidden">
                    <div class="absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-teal-500/10 blur-2xl"></div>
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <span class="text-[10px] tracking-widest uppercase text-gold-400 font-bold block">AURA DIGITAL KEY PASS</span>
                            <h4 class="font-bold text-base text-white">@Receipt.GuestName</h4>
                        </div>
                        <div class="px-2.5 py-1 rounded bg-gold-400/20 text-gold-300 text-[10px] font-mono font-bold">
                            VIP ACCESS
                        </div>
                    </div>
                    <div class="flex justify-between items-end border-t border-white/10 pt-4">
                        <div>
                            <span class="text-[10px] text-sand-400 block">Digital Token</span>
                            <span class="font-mono text-xs text-sand-200">@Receipt.DigitalPassKey</span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] text-sand-400 block">Total Settlement</span>
                            <span class="font-serif-luxury text-lg font-bold text-gold-300">@CurrencyService.FormatPrice(Receipt.FinalTotalUSD)</span>
                        </div>
                    </div>
                </div>

                <!-- Items Breakdown -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">Reserved Itinerary Manifest</h4>
                    <div class="space-y-2">
                        @foreach (var item in Receipt.Items)
                        {
                            <div class="p-3 rounded-xl bg-sand-50 border border-sand-200 flex justify-between items-center text-xs">
                                <div>
                                    <span class="font-bold text-slate-900 block">@item.Title</span>
                                    <span class="text-[11px] text-slate-500">@item.Destination &bull; @item.StartDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <span class="font-bold text-slate-800">@CurrencyService.FormatPrice(item.TotalUSD)</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Done Button -->
                <button @onclick="@(() => Presenter.DismissReceipt())"
                        class="w-full py-3.5 rounded-xl bg-primary-900 hover:bg-primary-950 text-white font-bold text-xs tracking-wider uppercase transition shadow-lg">
                    Return to Exploration
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public BookingReceipt? Receipt { get; set; }
}
