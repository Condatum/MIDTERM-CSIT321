@inject BookingPresenter Presenter
@inject IAppStateService AppState
@inject ICurrencyService CurrencyService
@inject IBookingService BookingService
@implements IBookingView
@implements IDisposable

@if (AppState.IsTripsDrawerOpen)
{
    <div class="fixed inset-0 z-50 overflow-hidden bg-slate-950/60 backdrop-blur-sm transition-opacity">
        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col justify-between border-l border-sand-200">
                <!-- Drawer Header -->
                <div class="p-6 border-b border-sand-200 flex justify-between items-center bg-sand-50/80">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-primary-900 text-gold-300 flex items-center justify-center">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-serif-luxury text-lg font-bold text-slate-900">Your Journey Manifest</h3>
                            <span class="text-[11px] text-slate-500">@_bookings.Count items selected</span>
                        </div>
                    </div>
                    <button @onclick="@(() => AppState.ToggleTripsDrawer(false))" class="text-slate-400 hover:text-slate-700 p-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Items List -->
                <div class="flex-1 overflow-y-auto p-6 space-y-4">
                    @if (!_bookings.Any())
                    {
                        <div class="py-20 text-center">
                            <div class="w-16 h-16 mx-auto rounded-full bg-sand-100 flex items-center justify-center text-slate-400 mb-3">
                                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                </svg>
                            </div>
                            <h4 class="font-bold text-sm text-slate-700">No Reservations In Progress</h4>
                            <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto">Explore our luxury private villas and bespoke world expeditions to curate your journey.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var b in _bookings)
                        {
                            <div class="p-4 rounded-2xl bg-sand-50/80 border border-sand-200 relative group">
                                <button @onclick="@(() => Presenter.RemoveItem(b.Id))"
                                        class="absolute top-3 right-3 text-slate-400 hover:text-rose-600 transition p-1">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                                <div class="flex gap-3">
                                    <img src="@b.ImageUrl" alt="@b.Title" class="w-16 h-16 rounded-xl object-cover shrink-0" />
                                    <div class="pr-6">
                                        <span class="text-[10px] uppercase font-bold tracking-wider text-primary-800">@b.ItemType &bull; @b.Destination</span>
                                        <h4 class="font-bold text-xs sm:text-sm text-slate-900 line-clamp-1">@b.Title</h4>
                                        <div class="text-[11px] text-slate-500 mt-1">
                                            <span>@b.StartDate.ToString("MMM dd")</span>
                                            @if (b.EndDate.HasValue)
                                            {
                                                <span> - @b.EndDate.Value.ToString("MMM dd") (@b.TotalNights nights)</span>
                                            }
                                            <span> &bull; @b.Guests Guests</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3 pt-3 border-t border-sand-200 flex justify-between items-center text-xs">
                                    <span class="text-slate-500">Total Privilege</span>
                                    <span class="font-bold text-slate-900 font-serif-luxury">@CurrencyService.FormatPrice(b.TotalUSD)</span>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Drawer Footer -->
                @if (_bookings.Any())
                {
                    <div class="p-6 border-t border-sand-200 bg-sand-50/80 space-y-4">
                        <div class="flex justify-between items-baseline text-sm">
                            <span class="text-slate-600 font-medium">Estimated Total</span>
                            <span class="font-serif-luxury text-2xl font-bold text-slate-900">
                                @CurrencyService.FormatPrice(_bookings.Sum(b => b.TotalUSD))
                            </span>
                        </div>
                        <button @onclick="@(() => Presenter.OpenCheckout())"
                                class="w-full py-4 rounded-2xl bg-gradient-to-r from-primary-800 to-primary-950 hover:from-primary-700 hover:to-primary-900 text-white font-bold text-xs tracking-wider uppercase transition shadow-xl shadow-primary-950/20 flex items-center justify-center gap-2">
                            <span>Proceed to VIP Checkout</span>
                            <svg class="w-4 h-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Modals -->
<BookingCheckoutModal IsOpen="_isCheckoutOpen" />
<ConfirmationReceiptModal Receipt="_latestReceipt" />

@code {
    private IReadOnlyList<BookingItem> _bookings = Array.Empty<BookingItem>();
    private BookingReceipt? _latestReceipt;
    private bool _isCheckoutOpen = false;

    protected override void OnInitialized()
    {
        Presenter.AttachView(this);
        AppState.OnStateChanged += StateHasChanged;
        CurrencyService.OnCurrencyChanged += StateHasChanged;
    }

    public void DisplayActiveBookings(IReadOnlyList<BookingItem> items)
    {
        _bookings = items;
        InvokeAsync(StateHasChanged);
    }

    public void DisplayReceipt(BookingReceipt? receipt)
    {
        _latestReceipt = receipt;
        InvokeAsync(StateHasChanged);
    }

    public void ShowCheckoutModal(bool isVisible)
    {
        _isCheckoutOpen = isVisible;
        InvokeAsync(StateHasChanged);
    }

    public void ShowMessage(string message, bool isError = false)
    {
        AppState.PushNotification(isError ? "Notice" : "Success", message, isError ? NotificationType.Warning : NotificationType.Success);
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= StateHasChanged;
        CurrencyService.OnCurrencyChanged -= StateHasChanged;
    }
}
