@inject DiningWellnessPresenter Presenter
@inject ICurrencyService CurrencyService
@inject IAppStateService AppState
@implements IDiningWellnessView

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-12">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-50 text-gold-800 text-[11px] font-bold uppercase tracking-wider mb-2 border border-gold-200">
            <span>Michelin Gastronomy & Holistic Sanctuaries</span>
        </div>
        <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-slate-900">
            Fine Dining & Ayurvedic Thermal Spas
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-xl">
            Subaquatic wine cellars, volcanic cliffside terraces, and high-altitude cryo detoxification.
        </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        @foreach (var item in _items)
        {
            <div class="group bg-white rounded-3xl overflow-hidden border border-sand-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
                <div>
                    <div class="relative h-64 w-full overflow-hidden bg-slate-900">
                        <img src="@item.ImageUrl" alt="@item.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                        <div class="absolute top-4 left-4">
                            <span class="px-2.5 py-1 rounded-full bg-slate-950/70 backdrop-blur-md text-white text-[10px] font-bold tracking-wider uppercase">
                                @item.Type &bull; @item.PriceTier
                            </span>
                        </div>
                        <div class="absolute bottom-4 left-4 right-4 text-white">
                            <span class="text-[11px] text-sand-200 block">@item.Destination &bull; @item.CuisineOrSpecialty</span>
                            <h3 class="font-serif-luxury text-xl font-bold text-white">@item.Name</h3>
                        </div>
                    </div>

                    <div class="p-6 space-y-3">
                        <p class="text-xs text-slate-600 leading-relaxed">@item.Description</p>
                        <div class="p-3 rounded-xl bg-sand-50 border border-sand-200 text-xs">
                            <span class="font-bold text-primary-900 uppercase text-[10px] block tracking-wider">Signature Offering</span>
                            <span class="text-slate-700 italic">"@item.SignatureOffering"</span>
                        </div>
                    </div>
                </div>

                <div class="p-6 pt-2 border-t border-sand-100 flex items-center justify-between">
                    <div class="flex items-center gap-1 text-xs font-bold text-gold-600">
                        <span>★</span>
                        <span>@item.Rating.ToString("F2") (Michelin Guide / Spa Stars)</span>
                    </div>
                    <button @onclick="@(() => Presenter.OpenReservation(item))"
                            class="px-5 py-2.5 rounded-xl bg-primary-900 hover:bg-primary-950 text-white text-xs font-bold tracking-wider uppercase transition shadow">
                        Reserve Table / Slot
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<!-- Reservation Modal -->
@if (_activeModalItem != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-950/70 backdrop-blur-md flex items-center justify-center p-4">
        <div class="relative bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-sand-200 animate-fade-in my-8 p-6 sm:p-8">
            <div class="flex justify-between items-center pb-4 border-b border-sand-200 mb-6">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-primary-800">Reservation Request</span>
                    <h3 class="font-serif-luxury text-xl font-bold text-slate-900">@_activeModalItem.Name</h3>
                </div>
                <button @onclick="@(() => Presenter.CloseReservation())" class="text-slate-400 hover:text-slate-700 p-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4 mb-6">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Date</label>
                        <input type="date" @bind="Presenter.CurrentRequest.Date" class="w-full text-xs p-2.5 rounded-xl border border-sand-300" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Time Slot</label>
                        <select @bind="Presenter.CurrentRequest.TimeSlot" class="w-full text-xs p-2.5 rounded-xl border border-sand-300">
                            <option value="12:30">12:30 (Lunch Seating)</option>
                            <option value="18:30">18:30 (Sunset Seating)</option>
                            <option value="20:00">20:00 (Evening Degustation)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Party Size</label>
                        <select @bind="Presenter.CurrentRequest.Guests" class="w-full text-xs p-2.5 rounded-xl border border-sand-300">
                            <option value="2">2 Guests</option>
                            <option value="4">4 Guests</option>
                            <option value="6">6 Guests</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Guest Name</label>
                        <input type="text" @bind="Presenter.CurrentRequest.GuestName" class="w-full text-xs p-2.5 rounded-xl border border-sand-300" />
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">Dietary & Seating Preferences</label>
                    <input type="text" @bind="Presenter.CurrentRequest.SpecialNotes" placeholder="e.g. Window / Oceanfront table, pescatarian menu" class="w-full text-xs p-2.5 rounded-xl border border-sand-300" />
                </div>
            </div>

            <button @onclick="@(() => Presenter.ConfirmReservation())"
                    class="w-full py-3.5 rounded-xl bg-primary-900 hover:bg-primary-950 text-white font-bold text-xs uppercase tracking-wider transition shadow-lg">
                Confirm Reservation
            </button>
        </div>
    </div>
}

@code {
    private IReadOnlyList<CulinaryWellnessItem> _items = Array.Empty<CulinaryWellnessItem>();
    private CulinaryWellnessItem? _activeModalItem;

    protected override void OnInitialized()
    {
        Presenter.AttachView(this);
    }

    public void DisplayItems(IReadOnlyList<CulinaryWellnessItem> items)
    {
        _items = items;
        InvokeAsync(StateHasChanged);
    }

    public void ShowReservationModal(CulinaryWellnessItem? item)
    {
        _activeModalItem = item;
        InvokeAsync(StateHasChanged);
    }
}
