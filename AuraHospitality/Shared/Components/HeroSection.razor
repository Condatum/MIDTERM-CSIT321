@inject IAppStateService AppState
@inject StaysPresenter StaysPresenter
@inject ToursPresenter ToursPresenter

<section class="relative min-h-[640px] flex items-center justify-center overflow-hidden bg-slate-950 text-white">
    <!-- Cinematic Background Image with Gradient Overlay -->
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1514282401047-d79a71a590e8?auto=format&fit=crop&w=2000&q=85"
             alt="Luxury Ocean Resort"
             class="w-full h-full object-cover object-center scale-105 transform animate-fade-in filter brightness-75 contrast-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-slate-900/60"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-slate-950/30 to-slate-950/80"></div>
    </div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
        <!-- Luxury Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-gold-300 text-xs font-semibold tracking-widest uppercase mb-6 shadow-xl">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
            World's Leading Luxury Hospitality & Tourism Portfolio
        </div>

        <!-- Headline -->
        <h1 class="font-serif-luxury text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight text-white mb-6 leading-[1.1] max-w-4xl mx-auto drop-shadow-lg">
            Where Timeless Hospitality Meets <span class="italic text-transparent bg-clip-text bg-gradient-to-r from-teal-200 via-gold-200 to-amber-300">Boundless Exploration</span>
        </h1>

        <p class="text-sand-100 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed font-light drop-shadow">
            Discover architectural sanctuaries, private island atolls, and bespoke high-latitude expeditions. Designed for the world’s most discerning travelers.
        </p>

        <!-- Search Bar Widget -->
        <div class="max-w-4xl mx-auto bg-white/95 backdrop-blur-xl p-3 sm:p-4 rounded-3xl shadow-2xl border border-white/30 text-slate-800 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-left">
            <!-- Destination Input -->
            <div class="p-2 sm:p-3 rounded-2xl bg-sand-50/80 hover:bg-white border border-sand-200 transition">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-primary-800 mb-1">Destination</label>
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <input type="text"
                           @bind="_searchDestination"
                           placeholder="Maldives, Alps, Positano..."
                           class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none placeholder-slate-400" />
                </div>
            </div>

            <!-- Dates -->
            <div class="p-2 sm:p-3 rounded-2xl bg-sand-50/80 hover:bg-white border border-sand-200 transition">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-primary-800 mb-1">Stay Duration</label>
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <select @bind="_durationOption" class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none cursor-pointer">
                        <option value="4">4 Nights (Weekend Retreat)</option>
                        <option value="7">7 Nights (Complete Immersion)</option>
                        <option value="14">14 Nights (Grand Tour)</option>
                    </select>
                </div>
            </div>

            <!-- Experience Type -->
            <div class="p-2 sm:p-3 rounded-2xl bg-sand-50/80 hover:bg-white border border-sand-200 transition">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-primary-800 mb-1">Sanctuary Type</label>
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    <select @bind="_experienceCategory" class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none cursor-pointer">
                        <option value="All">All Sanctuaries</option>
                        <option value="Overwater Villa">Overwater Villas</option>
                        <option value="Oceanfront Villas">Oceanfront Villas</option>
                        <option value="Alpine Chalet">Alpine Chalets</option>
                        <option value="Safari Pavilions">Safari Pavilions</option>
                        <option value="Cultural Heritage">Cultural Ryokans</option>
                    </select>
                </div>
            </div>

            <!-- Action Button -->
            <div class="flex items-center">
                <button @onclick="ExecuteSearch"
                        class="w-full h-full min-h-[48px] px-6 rounded-2xl bg-gradient-to-r from-primary-800 to-primary-950 hover:from-primary-700 hover:to-primary-900 text-white font-semibold text-sm tracking-wide shadow-lg shadow-primary-950/20 flex items-center justify-center gap-2 transition transform active:scale-95">
                    <svg class="w-4 h-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span>Search</span>
                </button>
            </div>
        </div>

        <!-- Live Metrics Bar -->
        <div class="mt-12 flex flex-wrap justify-center items-center gap-8 text-sand-300 text-xs">
            <div class="flex items-center gap-2">
                <span class="text-gold-400 font-bold text-base">8</span>
                <span>Exclusive Private Retreats</span>
            </div>
            <div class="h-4 w-px bg-white/20"></div>
            <div class="flex items-center gap-2">
                <span class="text-gold-400 font-bold text-base">6</span>
                <span>Curated Global Expeditions</span>
            </div>
            <div class="h-4 w-px bg-white/20"></div>
            <div class="flex items-center gap-2">
                <span class="text-gold-400 font-bold text-base">4.98</span>
                <span>Average Guest Rating</span>
            </div>
            <div class="h-4 w-px bg-white/20"></div>
            <div class="flex items-center gap-2">
                <span class="text-gold-400 font-bold text-base">100%</span>
                <span>Dedicated Island Butler Ratio</span>
            </div>
        </div>
    </div>
</section>

@code {
    private string _searchDestination = string.Empty;
    private string _durationOption = "7";
    private string _experienceCategory = "All";

    private async Task ExecuteSearch()
    {
        AppState.SetGuestNavTab("stays");
        StaysPresenter.Criteria.SearchQuery = _searchDestination;
        StaysPresenter.Criteria.Category = _experienceCategory;
        await StaysPresenter.ApplyFiltersAsync();
    }
}
