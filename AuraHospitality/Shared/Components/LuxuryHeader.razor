@inject IAppStateService AppState
@inject ICurrencyService CurrencyService
@inject IBookingService BookingService
@implements IDisposable

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-xl border-b border-sand-200 transition-all duration-200">
    <!-- Top Announcement Bar -->
    <div class="bg-primary-950 text-sand-200 text-xs py-1.5 px-4 sm:px-8 flex justify-between items-center">
        <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="tracking-widest uppercase font-medium text-[11px]">UNESCO Biosphere Sanctuary Certified &bull; 100% Carbon-Neutral Operations</span>
        </div>
        <div class="hidden md:flex items-center gap-6 text-[11px]">
            <span>24/7 Island Helipad & Marine Concierge</span>
            <span class="text-sand-400">&bull;</span>
            <span class="text-gold-400 font-medium">Use code <b>AURA10</b> for 10% privilege discount</span>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        <!-- Logo -->
        <div class="flex items-center gap-3 cursor-pointer" @onclick="GoToHome">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-primary-800 to-primary-950 flex items-center justify-center shadow-lg shadow-teal-950/20 text-gold-400 border border-gold-400/30">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                </svg>
            </div>
            <div>
                <span class="font-serif-luxury text-2xl font-bold tracking-wider text-slate-900 block leading-tight">AURA</span>
                <span class="text-[10px] tracking-widest uppercase text-primary-700 font-semibold block">Hospitality & Tourism Suite</span>
            </div>
        </div>

        <!-- Center Nav Tabs (Contextual based on View Mode) -->
        <nav class="hidden lg:flex items-center p-1.5 rounded-full bg-sand-100/80 border border-sand-200">
            @if (AppState.ViewMode == AppViewMode.GuestExperience)
            {
                <button @onclick="@(() => AppState.SetGuestNavTab("stays"))"
                        class="px-5 py-2 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 @(AppState.GuestNavTab == "stays" ? "bg-white text-primary-900 shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    Luxury Stays & Villas
                </button>
                <button @onclick="@(() => AppState.SetGuestNavTab("tours"))"
                        class="px-5 py-2 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 @(AppState.GuestNavTab == "tours" ? "bg-white text-primary-900 shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    Global Expeditions
                </button>
                <button @onclick="@(() => AppState.SetGuestNavTab("planner"))"
                        class="px-5 py-2 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 @(AppState.GuestNavTab == "planner" ? "bg-white text-primary-900 shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    Itinerary Planner
                </button>
                <button @onclick="@(() => AppState.SetGuestNavTab("dining"))"
                        class="px-5 py-2 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 @(AppState.GuestNavTab == "dining" ? "bg-white text-primary-900 shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    Michelin Dining & Spa
                </button>
            }
            else
            {
                <button @onclick="@(() => AppState.SetPmsNavTab("overview"))"
                        class="px-5 py-2 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 @(AppState.PmsNavTab == "overview" ? "bg-slate-900 text-white shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    PMS Dashboard
                </button>
                <button @onclick="@(() => AppState.SetPmsNavTab("rooms"))"
                        class="px-5 py-2 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 @(AppState.PmsNavTab == "rooms" ? "bg-slate-900 text-white shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    Room Rack & Folios
                </button>
                <button @onclick="@(() => AppState.SetPmsNavTab("tours"))"
                        class="px-5 py-2 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 @(AppState.PmsNavTab == "tours" ? "bg-slate-900 text-white shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    Tour Manifests
                </button>
                <button @onclick="@(() => AppState.SetPmsNavTab("housekeeping"))"
                        class="px-5 py-2 rounded-full text-xs font-semibold tracking-wide transition-all duration-200 @(AppState.PmsNavTab == "housekeeping" ? "bg-slate-900 text-white shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    Housekeeping & Butler
                </button>
            }
        </nav>

        <!-- Right Side: Mode Switcher, Currency, Cart, Concierge -->
        <div class="flex items-center gap-3">
            <!-- Portal / PMS Switcher Toggle -->
            <div class="flex items-center bg-sand-200/70 p-1 rounded-xl">
                <button @onclick="@(() => AppState.SetViewMode(AppViewMode.GuestExperience))"
                        title="Guest Luxury Experience"
                        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all @(AppState.ViewMode == AppViewMode.GuestExperience ? "bg-teal-700 text-white shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
                    </svg>
                    <span>Traveler</span>
                </button>
                <button @onclick="@(() => AppState.SetViewMode(AppViewMode.OperationsPMS))"
                        title="Internal Hotel & Tour Operations Hub"
                        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all @(AppState.ViewMode == AppViewMode.OperationsPMS ? "bg-slate-900 text-amber-300 shadow-sm" : "text-slate-600 hover:text-slate-900")">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>PMS Ops</span>
                </button>
            </div>

            <!-- Currency Selector -->
            <div class="relative">
                <select @onchange="OnCurrencyChanged"
                        class="appearance-none bg-sand-100 hover:bg-sand-200/80 border border-sand-300 text-slate-800 text-xs font-medium rounded-xl py-2 pl-3 pr-7 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary-500">
                    @foreach (var c in SupportedCurrencies.All.Values)
                    {
                        <option value="@c.Code" selected="@(CurrencyService.CurrentCurrency.Code == c.Code)">@c.Label</option>
                    }
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            </div>

            <!-- Celeste AI Concierge Button -->
            <button @onclick="@(() => AppState.ToggleConcierge())"
                    title="Talk to Celeste, Virtual Concierge"
                    class="relative p-2.5 rounded-xl bg-gradient-to-r from-teal-50 to-emerald-100 border border-teal-200 text-teal-800 hover:bg-teal-100 transition shadow-sm">
                <svg class="w-5 h-5 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
                <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white"></span>
            </button>

            <!-- Active Trips Drawer Button -->
            <button @onclick="@(() => AppState.ToggleTripsDrawer())"
                    class="relative flex items-center gap-2 px-3.5 py-2 rounded-xl bg-primary-800 hover:bg-primary-900 text-white font-semibold text-xs transition shadow-md shadow-primary-900/10">
                <svg class="w-4 h-4 text-gold-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span class="hidden sm:inline">My Trips</span>
                @if (BookingService.ActiveBookings.Count > 0)
                {
                    <span class="bg-gold-400 text-primary-950 text-[10px] font-bold px-1.5 py-0.5 rounded-full">
                        @BookingService.ActiveBookings.Count
                    </span>
                }
            </button>
        </div>
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        AppState.OnStateChanged += StateHasChanged;
        CurrencyService.OnCurrencyChanged += StateHasChanged;
        BookingService.OnBookingsChanged += StateHasChanged;
    }

    private void GoToHome()
    {
        AppState.SetViewMode(AppViewMode.GuestExperience);
        AppState.SetGuestNavTab("stays");
    }

    private void OnCurrencyChanged(ChangeEventArgs e)
    {
        if (e.Value is string code)
        {
            CurrencyService.SetCurrency(code);
        }
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= StateHasChanged;
        CurrencyService.OnCurrencyChanged -= StateHasChanged;
        BookingService.OnBookingsChanged -= StateHasChanged;
    }
}
