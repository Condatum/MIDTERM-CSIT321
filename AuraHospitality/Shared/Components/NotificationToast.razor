@inject IAppStateService AppState
@implements IDisposable

@if (AppState.Notifications.Any())
{
    <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-3 max-w-md w-full pointer-events-none">
        @foreach (var n in AppState.Notifications)
        {
            <div class="pointer-events-auto shadow-2xl rounded-2xl p-4 flex items-start gap-3 border transition-all duration-300 animate-bounce-subtle @GetStyleForType(n.Type)">
                <div class="mt-0.5 shrink-0">
                    @switch (n.Type)
                    {
                        case NotificationType.Success:
                            <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            break;
                        case NotificationType.Warning:
                            <svg class="w-6 h-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            break;
                        case NotificationType.Error:
                            <svg class="w-6 h-6 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            break;
                        default:
                            <svg class="w-6 h-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            break;
                    }
                </div>
                <div class="flex-1">
                    <h4 class="text-sm font-semibold text-slate-900">@n.Title</h4>
                    <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">@n.Message</p>
                </div>
                <button @onclick="() => AppState.DismissNotification(n.Id)" class="text-slate-400 hover:text-slate-700 p-1">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AppState.OnStateChanged += StateHasChanged;
    }

    private string GetStyleForType(NotificationType type) => type switch
    {
        NotificationType.Success => "bg-emerald-50/95 border-emerald-200 text-emerald-950 backdrop-blur-md",
        NotificationType.Warning => "bg-amber-50/95 border-amber-200 text-amber-950 backdrop-blur-md",
        NotificationType.Error => "bg-rose-50/95 border-rose-200 text-rose-950 backdrop-blur-md",
        _ => "bg-white/95 border-teal-100 text-slate-900 backdrop-blur-md"
    };

    public void Dispose()
    {
        AppState.OnStateChanged -= StateHasChanged;
    }
}
